# Scan outputs — regenerated every run.
reports/native/
reports/summary.md
reports/summary.html
reports/findings.json
reports/sbom.*.json

# Keep the reports/ dir tracked but empty.
!reports/.gitkeep

# Generated by scripts/render-env.py from scan-config.yml.
.env

# Offline preload cache (DBs + rulesets) — populated by ./preload.sh.
cache/

__pycache__/
*.pyc
.pytest_cache/
*.bak

# Per-engine exclude configs generated by scripts/render-env.py.
excludes/

# OS / tooling cruft
.DS_Store
.claude/
.img-empty/
.img-archive/
.docker-auth/
